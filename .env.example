# Credentials for any OpenAI-compatible endpoint.
# Copy this file to .env, fill in real values, and keep .env out of version control.

# Token for the endpoint (e.g. from your OpenRouter account).
OPENAI_COMPATIBLE_API_KEY=sk-your-token-here

# Optional: override the endpoint base URL (defaults to OpenRouter).
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1/
# 